# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/avelle

SITE_URL=http://localhost:8000

# Cloudinary (production media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (server-side only; never exposed to templates or JavaScript)
PAYSTACK_SECRET_KEY=

# Email (production SMTP; development prints emails to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AVELLE <no-reply@example.com>
